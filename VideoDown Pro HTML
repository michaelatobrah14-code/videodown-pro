<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mike.VideoDown Pro</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #090d19;
    color: white;
}

header {
    background: #11182a;
    text-align: center;
    padding: 25px;
    border-bottom: 2px solid #7655ff;
}

header h1 {
    color: #947aff;
    font-size: 30px;
}

header p {
    color: #aaa;
    margin-top: 8px;
}

.container {
    width: 90%;
    max-width: 480px;
    margin: 45px auto;
    padding: 25px;
    background: #151e32;
    border-radius: 18px;
}

h2 {
    text-align: center;
    margin-bottom: 12px;
}

.desc {
    text-align: center;
    color: #aaa;
    font-size: 14px;
    margin-bottom: 25px;
}

.platforms {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 25px;
}

.platforms button {
    padding: 14px 5px;
    background: #202b43;
    color: white;
    border: 1px solid #39445c;
    border-radius: 10px;
    cursor: pointer;
}

.platforms button.active {
    background: #7655ff;
}

input {
    width: 100%;
    padding: 16px;
    background: #0c1425;
    border: 1px solid #39445c;
    border-radius: 10px;
    color: white;
    outline: none;
    margin-bottom: 15px;
}

.download {
    width: 100%;
    padding: 16px;
    background: linear-gradient(90deg,#7655ff,#a14dff);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

#message {
    text-align: center;
    margin-top: 20px;
    color: #bbaaff;
    font-size: 14px;
    line-height: 1.6;
}

.features {
    display: flex;
    justify-content: space-around;
    margin-top: 25px;
    color: #aaa;
    font-size: 12px;
}

.telegram {
    display: block;
    text-align: center;
    margin-top: 25px;
    padding: 14px;
    background: #168bd0;
    color: white;
    border-radius: 10px;
    text-decoration: none;
}

footer {
    text-align: center;
    color: #777;
    padding: 25px;
    font-size: 13px;
}
</style>
</head>

<body>

<header>
    <h1>MIKE VIDEODOWN PRO</h1>
    <p>Your Simple Video Downloader</p>
</header>

<div class="container">

    <h2>Download Videos</h2>

    <p class="desc">
        Select your platform and paste your video link.
    </p>

    <div class="platforms">
        <button class="active"
        onclick="selectPlatform('TikTok',this)">
        TikTok</button>

        <button onclick="selectPlatform('Instagram',this)">
        Instagram</button>

        <button onclick="selectPlatform('Facebook',this)">
        Facebook</button>
    </div>

    <input type="url" id="videoLink"
    placeholder="Paste video link here...">

    <button class="download" onclick="processVideo()">
        DOWNLOAD VIDEO
    </button>

    <p id="message">
        Choose a platform to get started.
    </p>

    <div class="features">
        <span>⚡ Fast</span>
        <span>🎬 Video</span>
        <span>📱 Mobile</span>
    </div>

    <a class="telegram"
    href="https://t.me/" target="_blank">
        Join us on Telegram
    </a>

</div>

<footer>
    © 2026 VideoDown Pro
    <br><br>
    Download only videos you own or have permission to save.
    LET ENJOY AT MIKE VIDEODOWN PRO.
</footer>

<script>
let selectedPlatform = "TikTok";

function selectPlatform(platform, button) {
    selectedPlatform = platform;

    document.querySelectorAll(".platforms button")
    .forEach(btn => btn.classList.remove("active"));

    button.classList.add("active");

    document.getElementById("message").textContent =
        platform + " selected. Paste your video link.";
}

async function processVideo() {
    let link = document.getElementById("videoLink").value.trim();
    let message = document.getElementById("message");

    if (!link) {
        message.textContent = "Please paste a video link!";
        return;
    }

    message.textContent = "Checking your link...";

    try {
        const response = await fetch("/process", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                platform: selectedPlatform,
                link: link
            })
        });

        const data = await response.json();
        message.textContent = data.message;

    } catch (error) {
        message.textContent = "Could not connect to the server.";
    }
}
</script>

</body>
</html>
